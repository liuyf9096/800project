FROM debian:bullseye-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt update && apt install -y \
    build-essential \
    qt5-qmake \
    qtbase5-dev \
    libzmq5-dev \
    libmosquitto-dev \
    cmake \
    vim \
    git \
    && rm -rf /var/lib/apt/lists/*

# 不再 COPY 源码，只保留环境
WORKDIR /workspace
